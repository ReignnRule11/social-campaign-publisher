# Example environment variables for Social Campaign Publisher
DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=change-me # must be 16/24/32 raw bytes or base64 of that length
WEBHOOK_SECRET=change-me

# Retry/backoff settings
MAX_RETRIES=5
BASE_BACKOFF_SECONDS=2

# APScheduler jobstore (optional). Defaults to DATABASE_URL
JOBSTORE_URL=sqlite:///./jobs.db
